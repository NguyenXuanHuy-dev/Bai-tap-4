@model IEnumerable<baitap.Models.TodoItem>

@{
    ViewData["Title"] = "Danh sách công việc";
}

<div class="container text-center mt-4 border border-dark">
    <div class="header-banner">
        <h1 class="exercise-title m-0">BÀI TẬP VẬN DỤNG 2</h1>
    </div>
    <div class="p-3">
        <p>Xây dựng ứng dụng TodoList với các chức năng: Xem danh sách, chi tiết, thêm, sửa, xoá</p>
        
        <h2 class="mt-4">DANH SÁCH CÔNG VIỆC</h2>

    <div class="text-start mb-3">
        <a asp-action="Create" class="btn btn-link">Tạo mới công việc</a>
    </div>

    <table class="table table-bordered text-start">
        <thead>
            <tr>
                <th>Mã công việc</th>
                <th>Tên công việc</th>
                <th>Trạng thái hoàn thành</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>
                        <input type="checkbox" @(item.IsCompleted ? "checked" : "") disabled />
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id" onclick="return confirm('Bạn có chắc chắn muốn xoá?')">Xoá</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <div class="footer-banner"></div>
</div>
